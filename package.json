{
  "name": "online-mod-fork",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "description": "Development checks for the mersen1 fork of nb557/plugins",
  "scripts": {
    "build": "node scripts/build.cjs",
    "check": "node scripts/build.cjs --check && node scripts/check-syntax.cjs",
    "test": "node --test test/*.test.cjs",
    "probe": "node scripts/probe-providers.cjs",
    "probe:playback": "node scripts/probe-playback.cjs",
    "proxy:hdrezka": "pwsh -File scripts/start-hdrezka-proxy.ps1",
    "package:pages": "node scripts/package-pages.cjs"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "acorn": "8.19.0",
    "jquery": "3.7.1",
    "jsdom": "30.1.2",
    "json5": "2.2.3"
  },
  "dependencies": {
    "tough-cookie": "6.0.2"
  }
}
